<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay navigation category: the only category allowed to draw its own
	     content (the gauges). Must be granted by Apple for on-device builds. -->
	<key>com.apple.developer.carplay-maps</key>
	<true/>
</dict>
</plist>
